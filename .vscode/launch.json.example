{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "hit_app",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>"
      ]
    },
    {
      "name": "hit_app (profile)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>"
      ]
    }
  ]
}
